---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://giftmas.uk').href;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://giftmas.uk/images/giftmas-og.jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://giftmas.uk/images/giftmas-og.jpeg" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0B3D2E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css?v=4" />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Organization","name":"Giftmas","url":"https://giftmas.uk","logo":"https://giftmas.uk/images/giftmas-logo.jpeg"})} />
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"Giftmas","url":"https://giftmas.uk"})} />
  <!-- Cloudflare Web Analytics (cookieless). Replace the token value in the dashboard. -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE_WITH_YOUR_CF_WEB_ANALYTICS_TOKEN"}'></script>
</head>
<body>
  <div class="wrap">
    <slot />
  </div>
  <footer class="site-footer">
    <div class="footer-poem">
      <p>The lights are strung, the fire is bright,</p>
      <p>A quiet hush falls on the night.</p>
      <p>For gifts are more than what we buy,</p>
      <p>They're in the warmth of a joyful eye.</p>
      <p>So take your time, and choose with care,</p>
      <p>To show someone how much you care.</p>
    </div>
    <p>Links earn us a commission. As an Amazon Associate, I earn from qualifying purchases.</p>
    <p><a href="/">© 2026 Giftmas.uk</a></p>
  </footer>
</body>
</html>
