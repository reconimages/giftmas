---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Giftmas | AI Gift Finder UK" description="Find the perfect UK gift with our AI gift finder. Enter a budget, recipient and interests for personalized gift ideas from Amazon UK.">
  <header class="hero">
    <div class="brand-badge"><img src="/images/giftmas-logo.jpeg" alt="Giftmas" class="brand-logo" /></div>
    <h1>Find the perfect gift</h1>
    <p class="intro">Answer 4 quick questions and our AI will find 3 gift ideas tailored to them.</p>
  </header>

  <section class="quiz-container" id="quiz">
    <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
    <p class="progress" id="progress">Step 1 of 4</p>

    <div class="quiz-step active" data-step="1">
      <h2>Who is it for?</h2>
      <div class="options">
        <label class="option-card"><input type="radio" name="recipient" value="Partner" /> <span class="icon">❤️</span> Partner</label>
        <label class="option-card"><input type="radio" name="recipient" value="Parent" /> <span class="icon">🏠</span> Parent</label>
        <label class="option-card"><input type="radio" name="recipient" value="Friend" /> <span class="icon">🍻</span> Friend</label>
        <label class="option-card"><input type="radio" name="recipient" value="Colleague" /> <span class="icon">💼</span> Colleague</label>
        <label class="option-card"><input type="radio" name="recipient" value="Someone who has everything" /> <span class="icon">🎁</span> Someone who has everything</label>
      </div>
    </div>

    <div class="quiz-step" data-step="2" hidden>
      <h2>What do they love?</h2>
      <p class="intro">Tick any that apply, or type your own.</p>
      <div class="pill-group" id="interestPills">
        <button type="button" class="pill" data-value="Skincare">Skincare</button>
        <button type="button" class="pill" data-value="Travel">Travel</button>
        <button type="button" class="pill" data-value="Gaming">Gaming</button>
        <button type="button" class="pill" data-value="Coffee">Coffee</button>
        <button type="button" class="pill" data-value="Reading">Reading</button>
        <button type="button" class="pill" data-value="Fitness">Fitness</button>
        <button type="button" class="pill" data-value="Music">Music</button>
        <button type="button" class="pill" data-value="Cooking">Cooking</button>
      </div>
      <input id="interests" type="text" placeholder="e.g., skincare, gaming, coffee, travelling" maxlength="200" />
    </div>

    <div class="quiz-step" data-step="3" hidden>
      <h2>What's the budget?</h2>
      <div class="options">
        <button type="button" class="option-btn budget-btn" data-value="Under £15"><span class="tick">✓</span> Under £15</button>
        <button type="button" class="option-btn budget-btn" data-value="£15–£30"><span class="tick">✓</span> £15–£30</button>
        <button type="button" class="option-btn budget-btn" data-value="£30–£50"><span class="tick">✓</span> £30–£50</button>
        <button type="button" class="option-btn budget-btn" data-value="£50+"><span class="tick">✓</span> £50+</button>
      </div>
    </div>

    <div class="quiz-step" data-step="4" hidden>
      <h2>Practical or Luxury?</h2>
      <div class="options">
        <label class="option-card"><input type="radio" name="style" value="Practical & Useful" /> <span class="icon">🛠️</span> Practical & Useful</label>
        <label class="option-card"><input type="radio" name="style" value="A Little Luxury" /> <span class="icon">✨</span> A Little Luxury</label>
      </div>
    </div>

    <div class="quiz-nav">
      <button type="button" id="backBtn" hidden>Back</button>
      <div class="spacer"></div>
      <button type="button" id="nextBtn" class="btn-primary">Next</button>
      <button type="button" id="findBtn" class="btn-primary" hidden>Find My Gift</button>
    </div>
    <p class="error-msg" id="errorMsg" hidden>Please select an option to continue.</p>
  </section>

  <div id="recommendation-results"></div>

  <div class="category-section">
    <h2>Or browse popular categories 🎁</h2>
    <select id="categorySelect" class="category-select">
      <option value="" disabled selected>Select a category...</option>
      <option value="https://www.amazon.co.uk/s?k=stocking+fillers+under+10&tag=giftmas00-21">Stocking Fillers (Under £10)</option>
      <option value="https://www.amazon.co.uk/s?k=secret+santa+gifts+under+15&tag=giftmas00-21">Secret Santa (Under £15)</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+her&tag=giftmas00-21">Gifts for Her</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+him&tag=giftmas00-21">Gifts for Him</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+mum&tag=giftmas00-21">Gifts for Mum</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+dad&tag=giftmas00-21">Gifts for Dad</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+grandparents&tag=giftmas00-21">Gifts for Grandparents</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+kids&tag=giftmas00-21">Gifts for Kids</option>
      <option value="https://www.amazon.co.uk/s?k=teacher+gifts&tag=giftmas00-21">Gifts for Teachers</option>
      <option value="https://www.amazon.co.uk/s?k=gifts+for+gamers&tag=giftmas00-21">Gifts for Gamers</option>
      <option value="https://www.amazon.co.uk/s?k=beauty+gift+sets&tag=giftmas00-21">Beauty &amp; Skincare</option>
      <option value="https://www.amazon.co.uk/s?k=tech+gadgets+gifts&tag=giftmas00-21">Tech &amp; Gadgets</option>
      <option value="https://www.amazon.co.uk/s?k=home+and+kitchen+gifts&tag=giftmas00-21">Home &amp; Kitchen</option>
      <option value="https://www.amazon.co.uk/s?k=book+and+stationery+gifts&tag=giftmas00-21">Books &amp; Stationery</option>
      <option value="https://www.amazon.co.uk/s?k=food+and+drink+hampers&tag=giftmas00-21">Food &amp; Drink Hampers</option>
    </select>
  </div>

  <footer>Giftmas · <a href="/secret-santa">Secret Santa</a> · <a href="/gifts-for-girlfriend">Gifts for girlfriend</a></footer>

  <script is:inline>
    window.PAGE_SLUG = 'home';
  </script>
  <script is:inline>
  (function () {
    var sel = document.getElementById('categorySelect');
    if (sel) {
      sel.addEventListener('change', function () {
        var url = sel.value;
        if (url) { window.location.href = url; }
      });
    }
  })();
  </script>
  <script is:inline>
  (function () {
    var quizData = { recipient: '', interests: '', budget: '', style: '' };
    var selectedPills = [];
    var currentStep = 1;
    var totalSteps = 4;
    var progress = document.getElementById('progress');
    var progressFill = document.getElementById('progressFill');
    var backBtn = document.getElementById('backBtn');
    var nextBtn = document.getElementById('nextBtn');
    var findBtn = document.getElementById('findBtn');
    var results = document.getElementById('recommendation-results');
    var errorMsg = document.getElementById('errorMsg');
    var interestsInput = document.getElementById('interests');

    function showStep(n) {
      currentStep = n;
      document.querySelectorAll('.quiz-step').forEach(function (s) {
        var isThis = Number(s.getAttribute('data-step')) === n;
        s.classList.toggle('active', isThis);
        if (isThis) s.removeAttribute('hidden'); else s.setAttribute('hidden', '');
      });
      if (progress) progress.textContent = 'Step ' + n + ' of ' + totalSteps;
      if (progressFill) progressFill.style.width = (n / totalSteps * 100) + '%';
      if (backBtn) backBtn.hidden = (n === 1);
      if (nextBtn) nextBtn.hidden = (n === totalSteps);
      if (findBtn) findBtn.hidden = (n !== totalSteps);
      if (errorMsg) errorMsg.hidden = true;
      var quiz = document.getElementById('quiz');
      if (quiz) { quiz.classList.remove('shake'); }
    }

    function readStep(n) {
      if (n === 1) {
        var r = document.querySelector('input[name="recipient"]:checked');
        quizData.recipient = r ? r.value : '';
        return !!quizData.recipient;
      }
      if (n === 2) {
        quizData.interests = (interestsInput.value || '').trim();
        return quizData.interests.length > 0;
      }
      if (n === 3) return quizData.budget.length > 0;
      if (n === 4) {
        var s = document.querySelector('input[name="style"]:checked');
        quizData.style = s ? s.value : '';
        return !!quizData.style;
      }
      return true;
    }

    document.querySelectorAll('.budget-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.budget-btn').forEach(function (x) { x.classList.remove('selected'); });
        b.classList.add('selected');
        quizData.budget = b.getAttribute('data-value');
      });
    });
    document.querySelectorAll('.pill').forEach(function (p) {
      p.addEventListener('click', function () {
        var v = p.getAttribute('data-value');
        if (p.classList.contains('selected')) {
          p.classList.remove('selected');
          selectedPills = selectedPills.filter(function (x) { return x !== v; });
        } else {
          p.classList.add('selected');
          selectedPills.push(v);
        }
        interestsInput.value = selectedPills.join(', ');
      });
    });

    if (nextBtn) nextBtn.addEventListener('click', function () {
      if (!readStep(currentStep)) {
        if (errorMsg) errorMsg.hidden = false;
        var quiz = document.getElementById('quiz');
        if (quiz) { quiz.classList.remove('shake'); void quiz.offsetWidth; quiz.classList.add('shake'); }
        return;
      }
      if (currentStep < totalSteps) showStep(currentStep + 1);
    });
    if (backBtn) backBtn.addEventListener('click', function () {
      if (currentStep > 1) showStep(currentStep - 1);
    });

    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]); }); }

    async function findGifts() {
      if (!readStep(4)) {
        if (errorMsg) errorMsg.hidden = false;
        var quiz = document.getElementById('quiz');
        if (quiz) { quiz.classList.remove('shake'); void quiz.offsetWidth; quiz.classList.add('shake'); }
        return;
      }
      var query = 'Budget: ' + quizData.budget + '. Recipient: ' + quizData.recipient + '. Interests: ' + quizData.interests + '. Style: ' + quizData.style + '.';
      if (results) results.innerHTML = '<p class="loading"><span class="spinner"></span>Consulting Santa\'s helpers...</p>';
      try {
        var payload = { query: query, page: 'home' };
        console.log('Sending to API:', payload);
        var res = await fetch('/api/recommend', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var data = await res.json();
        if (!res.ok || !data.recommendations || data.recommendations.length === 0) throw new Error(data.error || 'no results');
        var cards = data.recommendations.map(function (r) {
          var title = r.title || '';
          var reason = r.reason || '';
          var term = r.searchTerm || title;
          var href = 'https://www.amazon.co.uk/s?k=' + encodeURIComponent(term) + '&tag=giftmas00-21';
          return '<article class="card fade-in"><h3>' + esc(title) + '</h3><p class="reason">' + esc(reason) + '</p><a class="buy" href="' + esc(href) + '" rel="sponsored nofollow noopener" target="_blank">Buy on Amazon</a></article>';
        }).join('');
        if (results) results.innerHTML = cards;
      } catch (err) {
        if (results) results.innerHTML = '<p class="error">Sorry, we couldn\'t find specific gifts for that. Try adding an age, budget, or interest.</p>';
      }
    }
    if (findBtn) findBtn.addEventListener('click', findGifts);

    showStep(1);
  })();
  </script>
</Layout>
