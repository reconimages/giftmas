---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Giftmas | Secret Santa Gifts Under £15 UK" description="Find Secret Santa gifts under £15 that won't get binned by Boxing Day. Smart UK gift finder for office and friend Secret Santa.">
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://giftmas.uk/"},{"@type":"ListItem","position":2,"name":"Secret Santa","item":"https://giftmas.uk/secret-santa/"}]})} />
  <header class="hero">
    <nav class="top-nav"><a href="/">← Home</a></nav>
    <div class="brand-badge"><img src="/images/giftmas-logo.jpeg" alt="Giftmas" class="brand-logo" /></div>
    <h1>Secret Santa gifts under £15 that won't get binned by Boxing Day</h1>
    <p class="countdown" id="countdown">Loading countdown…</p>
    <p class="intro">UK Secret Santa gifts that land well on a £10–£15 budget. Tell us about the recipient and we'll narrow it to 2–3 picks, not a list of ten.</p>
  </header>

  <section class="search-box">
    <h2>Find gifts</h2>
    <p class="intro">Type one sentence about the recipient. Example: "£12 budget, 30-year-old colleague, loves tea and biscuits."</p>
    <form id="gift-form">
      <input id="recipient" type="text" placeholder="e.g., £12 budget, 30-year-old colleague, loves tea and biscuits." required maxlength="300" />
      <button type="submit">Find Gifts</button>
    </form>
    <noscript><p>JavaScript is required for personalised recommendations. <a href="#picks">Browse our picks below</a>.</p></noscript>
    <div id="recommendation-results"></div>
  </section>

  <h2 id="picks">Editor's picks — paste real Amazon UK links here</h2>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Scented candle gift set</h3>
    <p class="reason">Cosy, useful and under budget — the kind of thing nobody bins.</p>
    <p class="band">around £10–£15 (estimate) · Home & Kitchen (5%)</p>
    <a class="buy" href="https://www.amazon.co.uk/s?k=secret+santa+gift+under+15&tag=giftmas00-21" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Novelty sock gift set</h3>
    <p class="reason">Cheap laughs plus warm feet; works for almost any office Secret Santa.</p>
    <p class="band">around £8–£12 (estimate) · Clothing & Accessories (6%)</p>
    <a class="buy" href="https://www.amazon.co.uk/s?k=funny+secret+santa+gift&tag=giftmas00-21" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Mini skincare discovery set</h3>
    <p class="reason">A little treat that feels fancier than its price.</p>
    <p class="band">around £10–£15 (estimate) · Standard Beauty (4%)</p>
    <a class="buy" href="https://www.amazon.co.uk/s?k=useful+secret+santa+gifts&tag=giftmas00-21" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>

  <p class="disclosure">Prices shown are estimates, not live Amazon prices.</p>

  <!-- footer provided by global layout -->

  <script is:inline>
    (function () {
      var now = new Date();
      var xmas = new Date(now.getFullYear(), 11, 25);
      if (now > xmas) xmas = new Date(now.getFullYear() + 1, 11, 25);
      var days = Math.ceil((xmas - now) / 86400000);
      var el = document.getElementById('countdown');
      if (el) el.textContent = days + ' days until Christmas. Order by 18 Dec for delivery.';
    })();
    window.PAGE_SLUG = 'secret-santa';
  </script>
  <script src="/app.js?v=3" is:inline></script>
</Layout>
