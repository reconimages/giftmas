---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#0B3D2E" />
  <link rel="stylesheet" href="/style.css" />
  <!-- Cloudflare Web Analytics (cookieless). Replace the token value in the dashboard. -->
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "REPLACE_WITH_YOUR_CF_WEB_ANALYTICS_TOKEN"}'></script>
</head>
<body>
  <div class="wrap">
    <slot />
  </div>
</body>
</html>
