---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Giftmas | Gifts for Girlfriend" description="Gifts for your girlfriend: skincare and beauty picks she'll actually use. UK Christmas gift ideas.">
  <header class="hero">
    <nav class="top-nav"><a href="/">← Home</a></nav>
    <div class="brand-badge"><img src="/images/giftmas-logo.jpeg" alt="Giftmas" class="brand-logo" /></div>
    <h1>Gifts for her: skincare and beauty picks she'll actually use</h1>
    <p class="countdown" id="countdown">Loading countdown…</p>
    <p class="intro">Skincare and beauty lead the way here — the UK's highest-commission gift category — with clothing and home picks in the mix. Tell us about her and we'll narrow it to 2–3 picks, not a list of ten.</p>
    <p class="disclosure">As an Amazon Associate, I earn from qualifying purchases.</p>
  </header>

  <section class="search-box">
    <h2>Find gifts with AI</h2>
    <p class="intro">Type one sentence about her. Example: "£30 budget, 27-year-old girlfriend, loves skincare and travelling."</p>
    <form id="gift-form">
      <input id="recipient" type="text" placeholder="e.g., £30 budget, 27-year-old girlfriend, loves skincare and travelling." required maxlength="300" />
      <button type="submit">Find Gifts</button>
    </form>
    <noscript><p>JavaScript is required for personalised recommendations. <a href="#picks">Browse our picks below</a>.</p></noscript>
    <div id="recommendation-results"></div>
  </section>

  <h2 id="picks">Editor's picks — paste real Amazon UK links here</h2>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Luxury skincare gift set</h3>
    <p class="reason">She loves skincare, so a pampering set she'd never buy herself.</p>
    <p class="band">around £25–£40 (estimate) · Luxury Beauty (6%)</p>
    <a class="buy" href="https://www.amazon.co.uk/s?k=travel+size+skincare+gift+set&tag=giftmas00-21" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Silk pyjama set</h3>
    <p class="reason">Cosy nights in, and a step up from her usual sleepwear.</p>
    <p class="band">around £25–£45 (estimate) · Clothing & Accessories (6%)</p>
    <a class="buy" href="https://www.amazon.co.uk/s?k=travel+accessories+for+women&tag=giftmas00-21" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Fragrance gift set</h3>
    <p class="reason">A classic she'll use every day, not just at Christmas.</p>
    <p class="band">around £30–£50 (estimate) · Luxury Beauty (6%)</p>
    <a class="buy" href="https://www.amazon.co.uk/s?k=luxury+beauty+gift+set+under+30&tag=giftmas00-21" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>

  <p class="disclosure">As an Amazon Associate, I earn from qualifying purchases. Prices shown are estimates, not live Amazon prices.</p>

  <footer>Giftmas · <a href="/secret-santa">Secret Santa</a> · Gifts for girlfriend</footer>

  <script is:inline>
    (function () {
      var now = new Date();
      var xmas = new Date(now.getFullYear(), 11, 25);
      if (now > xmas) xmas = new Date(now.getFullYear() + 1, 11, 25);
      var days = Math.ceil((xmas - now) / 86400000);
      var el = document.getElementById('countdown');
      if (el) el.textContent = days + ' days until Christmas. Order by 18 Dec for delivery.';
    })();
    window.PAGE_SLUG = 'gifts-for-girlfriend';
  </script>
  <script src="/app.js" is:inline></script>
</Layout>
