---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Secret Santa Gifts Under £15 | Giftmas" description="Secret Santa gifts under £15 that won't get binned by Boxing Day. UK Christmas gift ideas.">
  <header class="hero">
    <h1>Secret Santa gifts under £15 that won't get binned by Boxing Day</h1>
    <p class="countdown" id="countdown">Loading countdown…</p>
    <p class="intro">UK Secret Santa gifts that land well on a £10–£15 budget. Tell us about the recipient and we'll narrow it to 2–3 picks, not a list of ten.</p>
    <p class="disclosure">As an Amazon Associate, I earn from qualifying purchases.</p>
  </header>

  <h2 id="picks">Editor's picks — paste real Amazon UK links here</h2>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Scented candle gift set</h3>
    <p class="reason">Cosy, useful and under budget — the kind of thing nobody bins.</p>
    <p class="band">around £10–£15 (estimate) · Home & Kitchen (5%)</p>
    <a class="buy" href="PLACEHOLDER_LINK" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Novelty sock gift set</h3>
    <p class="reason">Cheap laughs plus warm feet; works for almost any office Secret Santa.</p>
    <p class="band">around £8–£12 (estimate) · Clothing & Accessories (6%)</p>
    <a class="buy" href="PLACEHOLDER_LINK" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>
  <!-- Replace PLACEHOLDER_LINK with real amazon.co.uk product URL + ?tag=giftmas00-21 -->
  <article class="card">
    <h3>Mini skincare discovery set</h3>
    <p class="reason">A little treat that feels fancier than its price.</p>
    <p class="band">around £10–£15 (estimate) · Standard Beauty (4%)</p>
    <a class="buy" href="PLACEHOLDER_LINK" rel="sponsored nofollow noopener" target="_blank">View on Amazon — editor: paste real ?tag=giftmas00-21 link here</a>
  </article>

  <h2>Try the AI picker</h2>
  <p class="intro">Type one sentence about the recipient. Example: "£12 budget, 30-year-old colleague, loves tea and biscuits."</p>
  <noscript><p>JavaScript is required for personalised recommendations. <a href="#picks">Browse our picks below</a>.</p></noscript>
  <form id="gift-form">
    <input id="recipient" type="text" placeholder="£12 budget, 30-year-old colleague, loves tea and biscuits." required maxlength="300" />
    <button type="submit">Pick 2–3 gifts</button>
  </form>
  <div id="results"></div>
  <p class="disclosure">As an Amazon Associate, I earn from qualifying purchases. Prices shown are estimates, not live Amazon prices.</p>

  <footer>Giftmas · Secret Santa · <a href="/gifts-for-girlfriend">Gifts for girlfriend</a></footer>

  <script is:inline>
    (function () {
      var now = new Date();
      var xmas = new Date(now.getFullYear(), 11, 25);
      if (now > xmas) xmas = new Date(now.getFullYear() + 1, 11, 25);
      var days = Math.ceil((xmas - now) / 86400000);
      var el = document.getElementById('countdown');
      if (el) el.textContent = days + ' days until Christmas. Order by 18 Dec for delivery.';
    })();
    window.PAGE_SLUG = 'secret-santa';
  </script>
  <script src="/app.js" is:inline></script>
</Layout>
